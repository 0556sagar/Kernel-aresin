# ==============================================================================
# POCO F3 GT (aresin / MT6893) - Non-GKI Kernel + KernelSU-Next boot.img Builder
# ==============================================================================
# Edit defaults here or override any value from GitHub Actions -> Run workflow.

# --- Device Identity ---
DEVICE_CODENAME="aresin"
KERNEL_NAME="KSUN-Aresin"
ARCH="arm64"
KBUILD_BUILD_USER="aresin-builder"
KBUILD_BUILD_HOST="github-actions"

# --- Kernel Source (Non-GKI 4.14 MT6893) ---
# Alternatives:
#   https://github.com/Tkpointz/android_kernel_aresin.git
#   https://github.com/AbzRaider/kernel_xiaomi_ares.git
# Or point this to your own fork matching your exact MIUI/HyperOS/AOSP ROM.
KERNEL_REPO="https://github.com/Tkpointz/android_kernel_aresin.git"
KERNEL_BRANCH=""                      # Leave empty to use the repo's default branch
KERNEL_SUBMODULES="false"
DEFCONFIG="ares_user_defconfig"       # Auto-checks ares_user_defconfig / ares_defconfig
EXTRA_CONFIGS=""

# --- Stock boot.img Source (Required for boot.img patching) ---
# Option A: Provide a direct download URL here or in the workflow input.
# Option B: Commit your ROM's stock boot.img at stock_boot/boot.img (via git-lfs or git add -f).
STOCK_BOOT_URL=""
STOCK_BOOT_LOCAL="stock_boot/boot.img"

# --- KernelSU-Next (Latest App Compatible, Non-GKI Legacy Branch) ---
# Official KernelSU-Next non-GKI branch: "legacy"
KSU_NEXT_REPO="KernelSU-Next/KernelSU-Next"
KSU_NEXT_BRANCH="legacy"
# Recommended for POCO F3 GT (ares/aresin 4.14.186): "manual"
# (kprobes is known to bootloop on MT6893 4.14 kernels; see KernelSU-Next issue #19)
KSU_HOOK_MODE="manual"                # manual | kprobe
ENABLE_ALLOWLIST_WORKAROUND="true"    # Sets CONFIG_KSU_ALLOWLIST_WORKAROUND=y
INCLUDE_MANAGER_APK="true"            # Downloads latest KernelSU-Next Manager APK alongside boot.img

# --- Toolchain (4.14 Non-GKI MT6893 Compatible) ---
# Options: zyc-clang | aosp-clang | custom-url
TOOLCHAIN="zyc-clang"
CLANG_VERSION="14"                    # 14 or 16 recommended for 4.14 MTK trees
CUSTOM_CLANG_URL=""
# Keep USE_GCC_COMPAT=true and LLVM_IAS=false for Linux 4.14 MT6893 compatibility
LLVM_IAS="false"
USE_GCC_COMPAT="true"
GCC64_REPO="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9.git"
GCC64_BRANCH="lineage-19.1"
GCC32_REPO="https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9.git"
GCC32_BRANCH="lineage-19.1"

# --- boot.img Repack Settings ---
# Pinned to v30.7 because Magisk v31.0 magiskboot alters signed AVB aux blocks on
# Xiaomi MediaTek devices without re-signing (see topjohnwu/Magisk issue #10078).
MAGISKBOOT_VERSION="v30.7"
REPLACE_DTB="false"                   # Keep stock DTB by default for maximum boot safety
